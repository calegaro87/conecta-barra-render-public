{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "env": { "EXPO_PUBLIC_API_URL": "https://conecta-barra-api.onrender.com", "EXPO_PUBLIC_EAS_PROJECT_ID": "c87bc760-536b-44e8-bf16-06ea027209d0" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": { "android": { "track": "internal", "releaseStatus": "draft" } }
  }
}
